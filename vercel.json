{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,

  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/**,public/**,api/index-template.html}"
    }
  },

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=604800,s-maxage=604800"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/api/news/digest",
      "destination": "/api/index?__vercel_original_path=/api/news/digest"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__vercel_original_path=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__vercel_original_path=/sitemap.xml"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/index?__vercel_original_path=/news-sitemap.xml"
    },
    {
      "source": "/google-news-sitemap.xml",
      "destination": "/api/index?__vercel_original_path=/google-news-sitemap.xml"
    },
    {
      "source": "/google:hash.html",
      "destination": "/api/index?hash=:hash&__vercel_original_path=/google:hash.html"
    },
    {
      "source": "/uploads/:filename",
      "destination": "/api/index?filename=:filename&__vercel_original_path=/uploads/:filename"
    },
    {
      "source": "/artikel/:slug",
      "destination": "/api/index?__vercel_original_path=/artikel/:slug"
    },
    {
      "source": "/berita/:slug",
      "destination": "/api/index?__vercel_original_path=/berita/:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__vercel_original_path=/api/:path*"
    },
    {
      "source": "/((?!api|assets|.*\\..*).*)",
      "destination": "/api/index"
    }
  ]
}
